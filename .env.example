APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP. Gmail / Google Workspace needs an App Password, not the normal one.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Win App"
# The name on every email. Separate from APP_NAME, which also derives the cache
# prefix and session cookie name and so must not be renamed.
MAIL_BRAND="Win App"

# Copied on every email the app sends, comma-separated. Password reset
# links are never copied — the link is a credential.
MAIL_ALWAYS_CC=

# Who gets the "changes waiting to be accepted" alert. Comma-separated.
# Empty falls back to MASTER_SHEET_OWNER_EMAIL.
APPROVAL_NOTIFICATION_EMAIL=
# Who is told when a film site and the app disagree. Blank falls back to the
# approval recipients, then the master sheet owner.
SITE_CHECK_NOTIFICATION_EMAIL=
# Copied on the film site alert only (MAIL_ALWAYS_CC copies everything).
SITE_CHECK_CC=
# Who gets Monday's weekly digest. Blank falls back to the approval
# recipients, then the master sheet owner.
WEEKLY_DIGEST_EMAIL=
# Copied on the weekly digest only (MAIL_ALWAYS_CC copies everything).
WEEKLY_DIGEST_CC=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mailchimp OAuth2 — from Account -> Extras -> Registered Apps in Mailchimp.
# Used by the CSV import feature. The redirect must match what is registered
# there exactly; leave it blank to use /settings/integrations/mailchimp/callback
# on APP_URL.
MAILCHIMP_OAUTH_CLIENT_ID=
MAILCHIMP_OAUTH_CLIENT_SECRET=
MAILCHIMP_OAUTH_REDIRECT=
MAILCHIMP_SMS_LIST_ID=
# The WIN APP audience auto-sync always writes to, per account. Blank uses the
# ids baked into config/services.php.
MAILCHIMP_WIN_APP_LIST_ID=
MAILCHIMP_USA_WIN_APP_LIST_ID=
SMS_SCHEDULER_OWNER_EMAIL=mj@adventureentertainment.com
